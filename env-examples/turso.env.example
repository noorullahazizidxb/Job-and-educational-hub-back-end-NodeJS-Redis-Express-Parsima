# Turso (libSQL). Runtime uses TURSO_DATABASE_URL. Prisma Migrate still uses the local SQLite file.

HOSTING_PLATFORM=local
NODE_ENV=production
PORT=4000
DB_PROVIDER=turso
TURSO_DATABASE_URL=libsql://YOUR-DATABASE.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-auth-token
SQLITE_URL=file:./dev.db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://jobs.devminds.net
REDIS_ENABLED=false
SEARCH_ENABLED=false
SOCKET_IO_ENABLED=false
CRON_SECRET=replace-with-a-random-cron-secret
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
