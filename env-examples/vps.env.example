# Ubuntu VPS. HOSTING_PLATFORM=local keeps Redis, search, and Socket.IO available.

HOSTING_PLATFORM=local
NODE_ENV=production
PORT=4000
DB_PROVIDER=postgresql
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/job_portal
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@127.0.0.1:5432/job_portal
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://jobs.devminds.net
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
SEARCH_ENABLED=false
ELASTICSEARCH_URL=
SOCKET_IO_ENABLED=true
SOCKET_IO_CORS_ORIGIN=https://jobs.devminds.net
CRON_SECRET=replace-with-a-random-cron-secret
GOOGLE_CLIENT_ID=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
