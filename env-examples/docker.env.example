# Docker Compose. Hostnames match the API repo compose services.

HOSTING_PLATFORM=local
NODE_ENV=production
PORT=4000
DB_PROVIDER=mysql
DATABASE_URL=mysql://root:password@mysql:3306/job_portal
DIRECT_URL=mysql://root:password@mysql:3306/job_portal
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379
SEARCH_ENABLED=true
ELASTICSEARCH_URL=http://elasticsearch:9200
SOCKET_IO_ENABLED=true
SOCKET_IO_CORS_ORIGIN=http://localhost:3000
CRON_SECRET=replace-with-a-random-cron-secret
GOOGLE_CLIENT_ID=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
