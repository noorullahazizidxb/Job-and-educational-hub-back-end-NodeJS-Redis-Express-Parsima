# Paid Vercel. Still serverless: Redis, Elasticsearch, and Socket.IO stay off.
# A paid plan can raise maxDuration in vercel.json and store uploads in Blob.

HOSTING_PLATFORM=vercel
NODE_ENV=production
PORT=4000
DB_PROVIDER=postgresql
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://jobs.devminds.net
REDIS_ENABLED=false
SEARCH_ENABLED=false
SOCKET_IO_ENABLED=false
CRON_SECRET=replace-with-a-random-cron-secret
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token
GOOGLE_CLIENT_ID=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
JSON_LIMIT=1mb
URLENCODED_LIMIT=1mb
