generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// MySQL schema — used when DB_PROVIDER=mysql.
// Connection URL lives in prisma.config.ts. The client receives a driver adapter.
datasource db {
  provider = "mysql"
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  website   String?
  logoUrl   String?
  industry  String?
  size      String?   // e.g., 11-50, 51-200
  about     String?
  description String
  address   String?
  cityId    Int?
  city      City?     @relation(fields: [cityId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs      Job[]
  users     User[]
  services  Service[]
  notificationRecipients NotificationRecipient[]

  @@index([name])
  @@index([cityId])
}

model Job {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  type        JobType
  location    String
  salaryMin   Int?
  salaryMax   Int?
  currency    String? @default("USD")
  description String
  skills      String   // comma separated for simplicity
  benefits    String?  // comma separated or plain text
  applyUrl    String?  // alternatively email
  applyEmail  String?
  contactEmail String?
  postedAt    DateTime @default(now())
  closingDate DateTime?
  vacancies   Int?     @default(1)
  experience  ExperienceLevel?
  education   EducationLevel?
  gender      Gender?
  orgType     OrganizationType?
  status      JobStatus @default(published)
  featured    Boolean   @default(false)
  featuredUntil DateTime?
  views       Int       @default(0)
  cityId      Int?
  city        City?     @relation(fields: [cityId], references: [id])
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  categories  JobCategory[]
  applications JobApplication[]
  reviews     JobReview[]

  @@index([title, location, type])
  @@index([status, closingDate])
  @@index([companyId])
  @@index([cityId])
  @@index([postedAt])
}

enum JobType {
  full_time
  part_time
  contract
  internship
  temporary
  remote
}

enum JobStatus {
  draft
  published
  closed
}

enum ExperienceLevel {
  entry
  mid
  senior
  lead
}

enum EducationLevel {
  high_school
  diploma
  bachelor
  master
  doctorate
}

enum Gender {
  any
  male
  female
}

enum OrganizationType {
  private
  government
  ngo
  international_org
  other
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs      JobCategory[]
}

model JobCategory {
  jobId     Int
  categoryId Int
  job       Job      @relation(fields: [jobId], references: [id])
  category  Category @relation(fields: [categoryId], references: [id])

  @@id([jobId, categoryId])
}

model City {
  id        Int      @id @default(autoincrement())
  name      String
  province  String?
  country   String?  @default("Afghanistan")
  companies Company[]
  jobs      Job[]
  services  Service[]
}

model Advertisement {
  id        Int      @id @default(autoincrement())
  title     String
  placement AdPlacement
  imageUrl  String
  targetUrl String
  isActive  Boolean  @default(true)
  startAt   DateTime?
  endAt     DateTime?
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, isActive, startAt, endAt])
}

enum AdPlacement {
  job_list_top
  middle_of_job_list
  home_page_after_pagenation_1
  home_page_after_pagenation_2
  middle_of_related_jobs_on_job_details
  company_list_top
  middle_of_company_list
  middle_of_related_companies_on_company_details
  service_list_top
  middle_of_service_list
  middle_of_related_services_on_service_details
}

// Services such as Procurement Opportunities and Scholarships
model Service {
  id           Int          @id @default(autoincrement())
  type         ServiceType
  title        String
  slug         String       @unique
  description String
  organization String?
  companyId    Int?
  company      Company?     @relation(fields: [companyId], references: [id])
  cityId       Int?
  city         City?        @relation(fields: [cityId], references: [id])
  country      String?      @default("Afghanistan")
  category     String?
  tags         String?      // comma separated
  eligibility  String?
  documents    Json?
  applyUrl     String?
  contactEmail String?
  postedAt     DateTime     @default(now())
  closingDate  DateTime?
  status       ServiceStatus @default(published)
  featured     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  applications ServiceApplication[]

  @@index([type, status, closingDate])
  @@index([companyId])
  @@index([cityId])
}

enum ServiceType {
  procurement
  scholarship
}

enum ServiceStatus {
  draft
  published
  closed
}

// Users & Roles
enum UserRole {
  common
  company
  admin
  employee
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  googleSub          String?   @unique
  passwordHash       String
  name               String?
  role               UserRole  @default(common)
  companyId          Int?
  company            Company?  @relation(fields: [companyId], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  jobApplications    JobApplication[]
  serviceApplications ServiceApplication[]
  jobReviews         JobReview[]
  createdNotifications Notification[] @relation("NotificationCreatedBy")
  notificationRecipients NotificationRecipient[]
  photo              String?   // Optional profile photo stored as /uploads/profile/<filename>
  about              String?   // Optional 'about me' text
  skills             String?   // Optional skills, comma separated
  phone              String?   // Optional phone number
  address            String?   // Optional address
  @@index([companyId])
}

// Notifications created by admins (or system) and recipients mapping
model Notification {
  id           Int       @id @default(autoincrement())
  title        String
  body         String?
  link         String?    // optional url to open when user clicks the notification
  createdById  Int?       // optional admin user who created the notification
  createdBy    User?      @relation("NotificationCreatedBy", fields: [createdById], references: [id])
  targetAll    Boolean    @default(false) // if true, intended for all users and companies
  targetRole   UserRole?              // optional: target users with specific role (e.g., company, common)
  sendAt       DateTime?              // scheduled send time, null => immediate
  createdAt    DateTime   @default(now())
  recipients   NotificationRecipient[]

  @@index([createdById])
}

// Mapping table to store per-recipient delivery/read state. A recipient can be a User or a Company.
model NotificationRecipient {
  id             Int          @id @default(autoincrement())
  notificationId Int
  notification   Notification @relation(fields: [notificationId], references: [id])

  // recipient can be either a user or a company (one of these will be set)
  userId         Int?
  user           User?        @relation(fields: [userId], references: [id])

  companyId      Int?
  company        Company?     @relation(fields: [companyId], references: [id])

  isRead         Boolean      @default(false)
  readAt         DateTime?

  createdAt      DateTime     @default(now())

  @@index([notificationId])
  @@index([userId])
  @@index([companyId])
  @@unique([notificationId, userId])
  @@unique([notificationId, companyId])
}

// Applications for Jobs
enum ApplicationStatus {
  applied
  viewed
  shortlisted
  rejected
  hired
  withdrawn
}

model JobApplication {
  id          Int               @id @default(autoincrement())
  jobId       Int
  job         Job               @relation(fields: [jobId], references: [id])
  userId      Int
  user        User              @relation(fields: [userId], references: [id])
  fullName    String
  email       String
  cvUrl       String?
  coverLetter String?
  answers     Json?
  status      ApplicationStatus @default(applied)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([jobId, userId])
  @@index([jobId, status])
  @@index([userId])
}

// Applications for Services (scholarships, procurements)
model ServiceApplication {
  id          Int               @id @default(autoincrement())
  serviceId   Int
  service     Service           @relation(fields: [serviceId], references: [id])
  userId      Int
  user        User              @relation(fields: [userId], references: [id])
  fullName    String
  email       String
  cvUrl       String?
  coverLetter String?
  status      ApplicationStatus @default(applied)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([serviceId, userId])
  @@index([serviceId, status])
  @@index([userId])
}

// Flexible key/value site settings
model Setting {
  key       String   @id
  value     String?
  json      Json?
  updatedAt DateTime @updatedAt
}

model JobReview {
  id        Int      @id @default(autoincrement())
  jobId     Int
  job       Job      @relation(fields: [jobId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([jobId])
}

// Contact submissions from site visitors
model Contact {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String?
  email       String
  phoneNumber String?
  message     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
}
