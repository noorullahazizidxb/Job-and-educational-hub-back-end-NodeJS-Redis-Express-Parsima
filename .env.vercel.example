# Paste these into the Vercel backend project (Settings → Environment Variables).
# SQLite files will not persist on Vercel. Use a hosted SQL database (Neon Postgres recommended).

HOSTING_PLATFORM=vercel
NODE_ENV=production
DB_PROVIDER=postgresql
DATABASE_URL=postgresql://USER:PASSWORD@HOST/job_portal?sslmode=require

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://jobs.devminds.net

REDIS_ENABLED=false
SEARCH_ENABLED=false
SOCKET_IO_ENABLED=false

CRON_SECRET=replace-with-a-random-cron-secret

# Optional: persistent file uploads
# BLOB_READ_WRITE_TOKEN=

JSON_LIMIT=1mb
URLENCODED_LIMIT=1mb
PROFILE_UPLOAD_LIMIT_BYTES=5242880
FILE_UPLOAD_LIMIT_BYTES=5242880
SERVICE_UPLOAD_LIMIT_BYTES=10485760
RATE_LIMIT_POINTS=100
RATE_LIMIT_DURATION=60
LOGIN_RATE_LIMIT_POINTS=5
LOGIN_RATE_LIMIT_DURATION=900
