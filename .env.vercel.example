# Paste these into the Vercel backend project (Settings → Environment Variables).
# SQLite files will not persist on Vercel. Use a hosted SQL database (Neon Postgres free tier).
# Use the Neon POOLED connection string (host contains "-pooler"). Direct connections exhaust serverless limits.
#
# Free Vercel forces Redis, Elasticsearch, Socket.IO, and BullMQ off even if the URLs below are set.
# To turn them on later, move to a VPS and set HOSTING_PLATFORM=local (see docs/ubuntu.md).
# Raising the function time limit above 10s requires a paid Vercel plan and a matching maxDuration in vercel.json.

HOSTING_PLATFORM=vercel
NODE_ENV=production
DB_PROVIDER=postgresql
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/job_portal?sslmode=require

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://jobs.devminds.net

# Stay false on free Vercel. On a VPS set true and fill the URL.
REDIS_ENABLED=false
# REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379
SEARCH_ENABLED=false
# ELASTICSEARCH_URL=https://YOUR-CLUSTER.es.io:9243
# ELASTICSEARCH_API_KEY=
SOCKET_IO_ENABLED=false

CRON_SECRET=replace-with-a-random-cron-secret

# Optional free persistent uploads (Vercel Blob). Leave unset and files live only in the function tmp dir.
# BLOB_READ_WRITE_TOKEN=

# Optional seed admin (prisma db seed). Change before seeding production.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-strong-password

# Optional Google reCAPTCHA v3 secret. Leave empty to skip server-side CAPTCHA.
# RECAPTCHA_SECRET_KEY=
# RECAPTCHA_MIN_SCORE=0.5

JSON_LIMIT=1mb
URLENCODED_LIMIT=1mb
PROFILE_UPLOAD_LIMIT_BYTES=5242880
FILE_UPLOAD_LIMIT_BYTES=5242880
SERVICE_UPLOAD_LIMIT_BYTES=10485760
RATE_LIMIT_POINTS=100
RATE_LIMIT_DURATION=60
LOGIN_RATE_LIMIT_POINTS=5
LOGIN_RATE_LIMIT_DURATION=900
