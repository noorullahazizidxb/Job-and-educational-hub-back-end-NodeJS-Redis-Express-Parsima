# ──────────────────────────────────────────────────────────────────────────────
# Docker Compose override variables
# Copy this file to .env.compose and edit before running:
#   docker compose --env-file .env.compose up --build
# ──────────────────────────────────────────────────────────────────────────────

# ── Path to the jobs-app frontend source ──────────────────────────────────────
# Windows (Docker Desktop with WSL2):  use Unix-style path via wsl or just absolute
# Linux / Mac:                          use absolute path
#
# Windows example (Docker Desktop):
#   FRONTEND_PATH=C:/Users/Noorullah/Downloads/.../jobs-app
# Linux / Mac example:
#   FRONTEND_PATH=/home/user/projects/jobs-app
#
FRONTEND_PATH=../jobs-app

# ── Infrastructure credentials ────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=Mcitp@123
MYSQL_DATABASE=job_service_db

REDIS_PASSWORD=sys

ES_PASSWORD=Mcitp@123

# ── App secrets (CHANGE IN PRODUCTION) ────────────────────────────────────────
JWT_SECRET=your_very_long_secure_jwt_secret_here

# ── API URL ───────────────────────────────────────────────────────────────────
# For local Docker: keep as localhost:4001 so browsers can reach the backend
# For production:   set to your public API domain (https://api.yourdomain.com)
NEXT_PUBLIC_API_BASE=http://localhost:4001

# Google reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# ── Optional ──────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
QUEUE_PREFIX=job-portal
