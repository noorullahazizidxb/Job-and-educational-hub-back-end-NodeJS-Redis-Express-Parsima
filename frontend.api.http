# Frontend Wiring API — Job Portal
# Use this as a working prompt/spec for GPT to integrate the frontend with the backend.
# Requires VS Code REST Client (humao.rest-client) if you want to run requests directly.

@base = http://localhost:4000
@ts = {{$timestamp}}
# Optional JWTs for protected endpoints (admin/company)
@adminToken = {{ADMIN_JWT}}
@companyToken = {{COMPANY_JWT}}

##############################
# Health
##############################
GET {{base}}/health

##############################
# Auth
##############################
# Login returns { token, user }
POST {{base}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "password123"
}

# Current user from bearer token
GET {{base}}/api/auth/me
Authorization: Bearer {{adminToken}}

##############################
# Settings: Theme
##############################
# Public: Get the active theme config used by next-themes and your design tokens
GET {{base}}/api/settings/theme

# Admin: Upsert the theme config
# json schema:
# {
#   light: { primary, accent, secondary, background, surface, muted, text, border, success, warning, danger },
#   dark:  { same keys as light },
#   tokens: {
#     radius: { button, input, card },
#     spacing: { xs, sm, md, lg, xl },
#     shadow: { sm, md, lg },
#     typography: { fontFamily, baseSize, lineHeight, weightRegular, weightMedium, weightBold },
#     transition: { duration, easing }
#   }
# }
PUT {{base}}/api/settings/theme
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "value": null,
  "json": {
    "light": {
      "primary": "#3b82f6",
      "accent": "#8b5cf6",
      "secondary": "#06b6d4",
      "background": "#ffffff",
      "surface": "#f8fafc",
      "muted": "#e5e7eb",
      "text": "#0f172a",
      "border": "#e2e8f0",
      "success": "#22c55e",
      "warning": "#f59e0b",
      "danger": "#ef4444"
    },
    "dark": {
      "primary": "#60a5fa",
      "accent": "#a78bfa",
      "secondary": "#22d3ee",
      "background": "#0b1220",
      "surface": "#111827",
      "muted": "#374151",
      "text": "#e5e7eb",
      "border": "#1f2937",
      "success": "#4ade80",
      "warning": "#fbbf24",
      "danger": "#f87171"
    },
    "tokens": {
      "radius": { "button": 6, "input": 6, "card": 10 },
      "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24 },
      "shadow": {
        "sm": "0 1px 2px rgba(0,0,0,0.05)",
        "md": "0 4px 6px rgba(0,0,0,0.1)",
        "lg": "0 10px 15px rgba(0,0,0,0.15)"
      },
      "typography": {
        "fontFamily": "Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif",
        "baseSize": 16,
        "lineHeight": 1.5,
        "weightRegular": 400,
        "weightMedium": 500,
        "weightBold": 700
      },
      "transition": { "duration": 200, "easing": "cubic-bezier(0.4, 0, 0.2, 1)" }
    }
  }
}

##############################
# Ads (Public)
##############################
# Get active banner for a placement (e.g., homepage hero, sitewide banner)
GET {{base}}/api/ads?placement=sitewide_banner&activeOnly=true&limit=1

# Other placements: homepage_hero | homepage_sidebar | job_list_top | job_detail_sidebar
GET {{base}}/api/ads?placement=homepage_hero&activeOnly=true&limit=5

##############################
# Jobs (Public)
##############################
# List jobs with filters: q, location, type (full_time|part_time|contract|internship|temporary|remote)
GET {{base}}/api/jobs?q=&location=&type=&page=1&pageSize=10

# Job detail by slug
GET {{base}}/api/jobs/frontend-developer-acme

##############################
# Companies (Public)
##############################
# List companies with optional search q
GET {{base}}/api/companies?q=

# Company detail by slug
GET {{base}}/api/companies/acme-corp

##############################
# Services (Public)
##############################
# List services with filters: type (scholarship|procurement), status, q
GET {{base}}/api/services?type=scholarship&status=published&q=&page=1&pageSize=10

# Service detail by slug
GET {{base}}/api/services/acme-scholarship-2025

##############################
# Categories & Cities (Public)
##############################
GET {{base}}/api/categories
GET {{base}}/api/cities

##############################
# Applications (Public)
##############################
# Apply to a job (multipart/form-data)
# Fields: jobId, userId, fullName, email, cv (file), coverLetter (file)
POST {{base}}/api/applications/jobs
Content-Type: multipart/form-data; boundary=MyBoundary

--MyBoundary
Content-Disposition: form-data; name="jobId"

1
--MyBoundary
Content-Disposition: form-data; name="userId"

1
--MyBoundary
Content-Disposition: form-data; name="fullName"

John Doe
--MyBoundary
Content-Disposition: form-data; name="email"

john@example.com
--MyBoundary
Content-Disposition: form-data; name="cv"; filename="cv.pdf"
Content-Type: application/pdf
Content-Transfer-Encoding: binary

< ./server/cv.pdf
--MyBoundary
Content-Disposition: form-data; name="coverLetter"; filename="coverletter.pdf"
Content-Type: application/pdf
Content-Transfer-Encoding: binary

< ./server/coverletter.pdf
--MyBoundary--

##############################
# Notes for Frontend Integration
##############################
# - Use next-themes to toggle between light/dark palettes from GET /settings/theme.
# - Feed color tokens and design tokens to your design system (tailwind/CSS-vars) at runtime.
# - Use zod to mirror the backend validation (see the theme JSON structure above) and react-hook-form for forms.
# - Use framer-motion for subtle transitions on page/section mounts and button interactions using tokens.transition.
