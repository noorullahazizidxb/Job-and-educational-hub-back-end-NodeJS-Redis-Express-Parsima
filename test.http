# REST Client tests for Job Portal API
# Prerequisites: VS Code REST Client extension (humao.rest-client)
# Notes:
# - Uses seeded users from prisma/seed.js: admin@example.com and company@example.com with password "password123".
# - Auth tokens are captured automatically and reused. Dynamic variables avoid unique constraint conflicts.
# - Avoid deleting seeded records; delete only test resources created in this file.

@base = http://localhost:4000
@ts = {{$timestamp}}
@token =eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjEyLCJyb2xlIjoiY29tbW9uIiwiY29tcGFueUlkIjpudWxsLCJpYXQiOjE3NTU1MDk0MjUsImV4cCI6MTc1NjExNDIyNX0.mi68xdF4so80qM_LG9nuQrEQvweFQLc3LoI06eSZweU
@companyToken =eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjIsInJvbGUiOiJjb21wYW55IiwiY29tcGFueUlkIjoxLCJpYXQiOjE3NTUzMjc0NjAsImV4cCI6MTc1NTkzMjI2MH0.2vOGon_sjLNjAaKSUSyDW-S4SnPvTA7bBNJd_OmxGQ4
# Placeholders to avoid undefined variable lint errors; these get overwritten by captures below.
@adminUserId = 3
@companyUserId = 2
@companyId = 1
@qaCompanyId = 2
@qaCompanySlug = qa-co-1755327638
@qaJobId = 0
@qaJobSlug = qa-job-1755327934
@qaServiceId = 0
@qaServiceSlug = qa-scholarship-1755328014
@qaAdId = 2
@qaCategoryId = 6
@qaCityId = 4
@applicantUserId = 3
@seededJobId = 1
@seededServiceId = 1

### Health
GET {{base}}/health

### Auth: Admin Login (captures token and user)
POST {{base}}/api/auth/login
Content-Type: application/json

{
  "email": "user1@example.com",
  "password": "password123"
}

### Auth: Company Login (captures token, userId, companyId)
POST {{base}}/api/auth/login
Content-Type: application/json

{
  "email": "company@example.com",
  "password": "password123"
}

### Auth: Me (admin)
GET {{base}}/api/auth/me
Authorization: Bearer {{token}}

##############################
# Companies
##############################

### Companies: List with filters and pagination
GET {{base}}/api/companies?q=acme&page=1&pageSize=10

### Companies: Detail by slug (seeded)
GET {{base}}/api/companies/acme-corp

### Companies: Create (admin) a QA company (captures id & slug)
POST {{base}}/api/companies
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "QA Co {{ts}}",
  "slug": "qa-co-{{ts}}",
  "website": "https://qa{{ts}}.example.com",
  "logoUrl": "https://picsum.photos/200?{{ts}}",
  "industry": "Testing",
  "size": "1-10",
  "about": "Test company",
  "description": "Created by REST tests",
  "address": "42 Test Street"
}


### Companies: Update (admin) the QA company
PATCH {{base}}/api/companies/{{qaCompanySlug}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "about": "Updated about {{ts}}"
}

### Companies: Delete (admin) the QA company
DELETE {{base}}/api/companies/{{qaCompanySlug}}
Authorization: Bearer {{token}}

##############################
# Jobs
##############################

### Jobs: List
GET {{base}}/api/jobs

### Jobs: List (default includes avgRating, reviewCount, and latest 3 reviews per job)
GET {{base}}/api/jobs

### Jobs: List (disable embedded reviews but keep aggregates)
GET {{base}}/api/jobs?withReviewsCount=0

### Jobs: List (embed only latest 2 reviews per job)
GET {{base}}/api/jobs?withReviewsCount=2


### Jobs: Detail (seeded) — capture seeded job id
GET {{base}}/api/jobs/frontend-developer-acme


### Jobs: Create (company) a QA job (captures slug & id)
POST {{base}}/api/jobs
Authorization: Bearer {{companyToken}}
Content-Type: application/json

{
  "slug": "qa-job-{{ts}}",
  "title": "QA Engineer {{ts}}",
  "type": "full_time",
  "location": "Kabul",
  "salaryMin": 100,
  "salaryMax": 200,
  "currency": "USD",
  "description": "Test job created by REST tests",
  "skills": "Testing,Automation",
  "companyId": {{companyId}},
  "categoryIds": []
}


### Jobs: Update (company) the QA job
PATCH {{base}}/api/jobs/{{qaJobSlug}}
Authorization: Bearer {{companyToken}}
Content-Type: application/json

{
  "featured": true
}

### Jobs: Delete (company) the QA job
DELETE {{base}}/api/jobs/{{qaJobSlug}}
Authorization: Bearer {{companyToken}}

### Jobs: Add Review to seeded job (authenticated user)
POST {{base}}/api/jobs/frontend-developer-acme/reviews
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rating": 5,
  "comment": "Excellent role — clear requirements and supportive team."
}

### Jobs: Add Review to QA job (if created) — uses captured slug
POST {{base}}/api/jobs/{{qaJobSlug}}/reviews
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rating": 4,
  "comment": "Good opportunity, applied and had a prompt reply."
}

### Jobs: Verify Review in Job Detail (seeded)
GET {{base}}/api/jobs/frontend-developer-acme

### Jobs: Verify Reviews in List (embed latest 5 reviews per job)
GET {{base}}/api/jobs?withReviewsCount=5

##############################
# Services (Scholarships / Procurements)
##############################

### Services: List
GET {{base}}/api/services?type=scholarship&status=published&q=acme&page=1&pageSize=10

### Services: Detail (seeded) — capture seeded service id
GET {{base}}/api/services/acme-scholarship-2025


### Services: Create (company) a QA service
POST {{base}}/api/services
Authorization: Bearer {{companyToken}}
Content-Type: application/json

{
  "type": "scholarship",
  "title": "QA Scholarship {{ts}}",
  "slug": "qa-scholarship-{{ts}}",
  "description": "Scholarship created by REST tests",
  "organization": "QA Foundation",
  "companyId": {{companyId}},
  "country": "Afghanistan",
  "category": "QA",
  "tags": "scholarship,testing",
  "eligibility": "Undergrad",
  "applyUrl": "https://example.com/apply/{{ts}}",
  "status": "published"
}


### Services: Update (company) the QA service
PATCH {{base}}/api/services/{{qaServiceSlug}}
Authorization: Bearer {{companyToken}}
Content-Type: application/json

{
  "featured": true
}

### Services: Delete (company) the QA service
DELETE {{base}}/api/services/{{qaServiceSlug}}
Authorization: Bearer {{companyToken}}

##############################
# Advertisements (Admin/Employee)
##############################

### Ads: List active for a placement (seeded)
GET {{base}}/api/ads?placement=homepage_hero&activeOnly=true&limit=5

### Ads: Create (admin) a QA ad (captures id)
POST {{base}}/api/ads
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "QA Ad {{ts}}",
  "placement": "homepage_hero",
  "imageUrl": "https://picsum.photos/1200/400?{{ts}}",
  "targetUrl": "https://example.com/q/{{ts}}",
  "isActive": true,
  "priority": 5
}


### Ads: Update (admin) the QA ad
PATCH {{base}}/api/ads/{{qaAdId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "priority": 9
}

### Ads: Delete (admin) the QA ad
DELETE {{base}}/api/ads/{{qaAdId}}
Authorization: Bearer {{token}}

