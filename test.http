# REST Client tests for Job Portal API
# Prerequisites: VS Code REST Client extension (humao.rest-client)
# Notes:
# - Uses seeded users from prisma/seed.js: admin@example.com and company@example.com with password "password123".
# - Auth tokens are captured automatically and reused. Dynamic variables avoid unique constraint conflicts.
# - Avoid deleting seeded records; delete only test resources created in this file.

@base = http://localhost:4000
@ts = {{$timestamp}}
@adminToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjEsInJvbGUiOiJhZG1pbiIsImNvbXBhbnlJZCI6bnVsbCwiaWF0IjoxNzU2NTE1NDQyLCJleHAiOjE3NTcxMjAyNDJ9.Avabc-51Z_7CslBaTIcrABcT2b3YcT3VHA7Yesv7oOA
@companyToken = 
@commonToken = 
# Placeholders to avoid undefined variable lint errors; these get overwritten by captures below.
@adminUserId = 1
@companyUserId = 2
@companyId = 1
@qaCompanyId = 2
@qaCompanySlug = qa-co-1755327638
@qaJobId = 0
@qaJobSlug = qa-job-1755327934
@qaServiceId = 0
@qaServiceSlug = qa-scholarship-1755328014
@qaAdId = 2
@qaCategoryId = 6
@qaCityId = 4
@applicantUserId = 12
@seededJobId = 2
@seededServiceId = 1

### Health
GET {{base}}/health

### Auth: Admin Login (captures adminToken and adminUserId)
POST {{base}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "password123"
}

### Auth: Common Login (captures commonToken and applicantUserId)
POST {{base}}/api/auth/login
Content-Type: application/json

{
  "email": "user1@example.com",
  "password": "password123"
}

> {% 
if (response.body && response.body.token) {
  client.global.set("commonToken", response.body.token);
}
if (response.body && response.body.user) {
  client.global.set("applicantUserId", String(response.body.user.id));
}
%}

### Auth: Company Login (captures companyToken, userId, companyId)
POST {{base}}/api/auth/login
Content-Type: application/json

{
  "email": "company@example.com",
  "password": "password123"
}

> {% 
if (response.body && response.body.token) {
  client.global.set("companyToken", response.body.token);
}
if (response.body && response.body.user) {
  client.global.set("companyUserId", String(response.body.user.id));
  if (response.body.user.companyId) client.global.set("companyId", String(response.body.user.companyId));
}
%}

### Auth: Me (common)
GET {{base}}/api/auth/me
Authorization: Bearer {{commonToken}}

> {% 
// Capture the logged-in user's id for use in applications
if (response.body && response.body.user) {
  client.global.set("applicantUserId", String(response.body.user.id));
}
%}

##############################
# Companies
##############################

### Companies: List with filters
GET {{base}}/api/companies?q=acme

### Companies: Detail by slug (seeded)
GET {{base}}/api/companies/acme-corp

### Companies: Create (admin) a QA company (captures id & slug)
POST {{base}}/api/companies
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "QA Co {{ts}}",
  "slug": "qa-co-{{ts}}",
  "website": "https://qa{{ts}}.example.com",
  "logoUrl": "https://picsum.photos/200?{{ts}}",
  "industry": "Testing",
  "size": "1-10",
  "about": "Test company",
  "description": "Created by REST tests",
  "address": "42 Test Street"
}


### Companies: Update (admin) the QA company
PATCH {{base}}/api/companies/{{qaCompanySlug}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "about": "Updated about {{ts}}"
}

### Companies: Delete (admin) the QA company
DELETE {{base}}/api/companies/{{qaCompanySlug}}
Authorization: Bearer {{adminToken}}

##############################
# Jobs
##############################

### Jobs: List
GET {{base}}/api/jobs

### Jobs: Featured (full relations)
GET {{base}}/api/jobs/featured

### Jobs: List (default includes avgRating, reviewCount, and latest 3 reviews per job)
GET {{base}}/api/jobs/frontend-developer-acme

### Jobs: List (disable embedded reviews but keep aggregates)
GET {{base}}/api/jobs?withReviewsCount=0

### Jobs: List (embed only latest 2 reviews per job)
GET {{base}}/api/jobs?withReviewsCount=2


### Jobs: Detail (seeded) — capture seeded job id
GET {{base}}/api/jobs/frontend-developer-acme

> {% 
// Capture the seeded job id
if (response.body && response.body.id) {
  client.global.set("seededJobId", String(response.body.id));
}
%}


### Jobs: List by companyId (company)
GET {{base}}/api/jobs/by-company/{{companyId}}
Authorization: Bearer {{companyToken}}


### Jobs: Create (company) a QA job (captures slug & id)
POST {{base}}/api/jobs
Authorization: Bearer {{companyToken}}
Content-Type: application/json

{
  "slug": "qa-job-{{ts}}",
  "title": "QA Engineer {{ts}}",
  "type": "full_time",
  "location": "Kabul",
  "salaryMin": 100,
  "salaryMax": 200,
  "currency": "USD",
  "description": "Test job created by REST tests",
  "skills": "Testing,Automation",
  "companyId": {{companyId}},
  "categoryIds": []
}


### Jobs: Update (company) the QA job
PATCH {{base}}/api/jobs/{{qaJobSlug}}
Authorization: Bearer {{companyToken}}
Content-Type: application/json

{
  "featured": true
}

### Jobs: Delete (company) the QA job
DELETE {{base}}/api/jobs/{{qaJobSlug}}
Authorization: Bearer {{companyToken}}

### Jobs: Add Review to seeded job (authenticated user)
POST {{base}}/api/jobs/frontend-developer-acme/reviews
Authorization: Bearer {{commonToken}}
Content-Type: application/json

{
  "rating": 5,
  "comment": "Excellent role — clear requirements and supportive team."
}

### Jobs: Add Review to QA job (if created) — uses captured slug
POST {{base}}/api/jobs/{{qaJobSlug}}/reviews
Authorization: Bearer {{commonToken}}
Content-Type: application/json

{
  "rating": 4,
  "comment": "Good opportunity, applied and had a prompt reply."
}

### Jobs: Verify Review in Job Detail (seeded)
GET {{base}}/api/jobs/frontend-developer-acme

### Jobs: Verify Reviews in List (embed latest 5 reviews per job)
GET {{base}}/api/jobs?withReviewsCount=5

