{
  "name": "job-portal-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon ./src/index.js",
    "start": "node ./src/index.js",
    "stack": "node ./scripts/stack.mjs",
    "setup": "node ./scripts/stack.mjs --setup-only",
    "setup:defaults": "node ./scripts/stack.mjs --setup-only --defaults",
    "build": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:sqlite": "DB_PROVIDER=sqlite prisma migrate deploy",
    "migrate:postgres": "DB_PROVIDER=postgresql prisma migrate deploy",
    "migrate:reset:sqlite": "DB_PROVIDER=sqlite prisma migrate reset",
    "generate": "prisma generate",
    "generate:sqlite": "DB_PROVIDER=sqlite prisma generate",
    "generate:postgres": "DB_PROVIDER=postgresql prisma generate",
    "seed": "prisma db seed",
    "lint": "eslint .",
    "worker": "node ./src/queue/imageProcessor.js",
    "cleanup": "node ./src/queue/dailyCleanup.js",
    "check:services": "node -r dotenv/config ./scripts/check-connectivity.js",
    "reindex:es": "node -r dotenv/config ./scripts/reindex-all.js",
    "deploy:vercel": "bash scripts/deploy-vercel.sh",
    "deploy:vercel:all": "bash scripts/deploy-vercel-all.sh",
    "docker:up": "bash scripts/docker-up.sh",
    "dev:vercel": "node ./scripts/dev-vercel.mjs"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.1.1",
    "@prisma/client": "^6.19.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.58.5",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "rate-limiter-flexible": "^7.3.0",
    "sharp": "^0.32.5",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^10.1.0",
    "nodemon": "^3.1.7",
    "prisma": "^6.19.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
