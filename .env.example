# Server
PORT=4000
NODE_ENV=development

# Body size limits
JSON_LIMIT=100kb
URLENCODED_LIMIT=100kb

# Upload limits (bytes)
# ==========================
# job-service-back-end env example (clean, de-duplicated)
# Copy to .env and edit values for your environment
# ==========================

# Server
PORT=4000
NODE_ENV=development

# Database (Prisma v7) — configured via prisma.config.ts
# DB_PROVIDER: "mysql" (default/production) or "sqlite" (lightweight dev)
DB_PROVIDER=mysql

# MySQL connection string (used when DB_PROVIDER=mysql)
# Example: mysql://user:pass@127.0.0.1:3306/dbname
DATABASE_URL="mysql://root:password@127.0.0.1:3306/job_portal"

# SQLite connection (used when DB_PROVIDER=sqlite)
SQLITE_URL="file:./dev.db"

# Request body limits
JSON_LIMIT=100kb
URLENCODED_LIMIT=100kb

# File upload limits (bytes)
# Default profile upload limit: 5MB
PROFILE_UPLOAD_LIMIT_BYTES=5242880
# Default general file upload limit: 5MB
FILE_UPLOAD_LIMIT_BYTES=5242880
# Default service upload limit: 10MB
SERVICE_UPLOAD_LIMIT_BYTES=10485760

# Redis (used for cache, rate limiting and BullMQ queues)
REDIS_URL=redis://127.0.0.1:6379
# If your Redis requires authentication, set REDIS_PASSWORD.
# Note: avoid setting REDIS_USERNAME unless you have ACL users configured in Redis 6+.
# Example password for local dev
#REDIS_PASSWORD=sys

# Rate limiting (rate-limiter-flexible)
# RATE_LIMIT_POINTS: requests allowed per duration
# RATE_LIMIT_DURATION: duration in seconds
RATE_LIMIT_POINTS=100
RATE_LIMIT_DURATION=60
LOGIN_RATE_LIMIT_POINTS=5
LOGIN_RATE_LIMIT_DURATION=900

# BullMQ / queue settings
QUEUE_PREFIX=job-portal

# Cleanup / maintenance scheduler
# If true the cleanup will run in dry-run mode (no deletions)
CLEANUP_DRY_RUN=false
# Number of days after closingDate to permanently delete
CLEANUP_AFTER_DAYS=15
# Cron expression for daily cleanup (default: run daily at 02:30 UTC)
CLEANUP_CRON="30 2 * * *"
# Timezone for cron (optional)
CRON_TZ=UTC

# Optional worker role guard (set on the single process that should run repeatable jobs)
# e.g. WORKER_ROLE=primary (if unset, scheduler will be registered by any process that imports it)
#WORKER_ROLE=primary

# Ghostscript / PDF optimization — set to true if Ghostscript is installed and you want PDFs optimized
GHOSTSCRIPT_ENABLED=true

# Prisma slow query threshold (ms)
PRISMA_SLOW_QUERY_MS=200

# JWT secret (set a secure value in production)
JWT_SECRET=your_jwt_secret_here
# JWT token expiration (optional)
JWT_EXPIRES_IN=7d

# Admin user defaults (used by `prisma/seed.js` if provided)
# Set these to create a custom admin during seeding. Defaults in seed: admin@example.com / password123
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password123

# Optional: AWS S3 config for presigned uploads (if you enable S3 storage)
AWS_S3_BUCKET=your-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Logging
LOG_LEVEL=info

# Optional: Elasticsearch
# If you use Elasticsearch, set the URL and one of the auth methods below.
#ELASTICSEARCH_URL=http://127.0.0.1:9200
#ELASTICSEARCH_API_KEY=your_api_key
#ELASTICSEARCH_USERNAME=elastic
#ELASTICSEARCH_PASSWORD=your_password
# If your server requires media-type compatibility 7 or 8, set this.
# Defaults to 8. Example errors fixed by this:
#   media_type_header_exception: Accept version must be either version 8 or 7
#ES_COMPATIBILITY=8

# WebSocket / Socket.IO settings (optional)
# The API starts Socket.IO on the same port as the HTTP server when enabled.
# If you need to restrict origins for client connections, set SOCKET_IO_CORS_ORIGIN.
SOCKET_IO_ENABLED=true
# Example: SOCKET_IO_CORS_ORIGIN=https://app.example.com
SOCKET_IO_CORS_ORIGIN=*
# Optional: change socket.io path (default /socket.io)
SOCKET_IO_PATH=/socket.io

# Optional: override the index names used by the application.
# Defaults: companies, jobs, services, users, applications
ES_INDEX_COMPANIES=companies
ES_INDEX_JOBS=jobs
ES_INDEX_SERVICES=services
ES_INDEX_USERS=users
ES_INDEX_APPLICATIONS=applications

# Google reCAPTCHA v3 (server-side siteverify for /api/auth/login)
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
